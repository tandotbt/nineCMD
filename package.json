{
  "name": "vue-project",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:ts": "vite --config vite-ts.config.js --host",
    "build": "vite build",
    "build:ts": "vite build --config vite-ts.config.js",
    "preview": "vite preview --host",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "test": "vitest run --config src-ts/vitest.config.ts",
    "test:watch": "vitest watch --config src-ts/vitest.config.ts",
    "check:ts": "npx vue-tsc --noEmit"
  },
  "dependencies": {
    "@intlify/core-base": "^11.4.4",
    "@vueuse/core": "14.3.0",
    "crypto-js": "4.2.0",
    "nanoid": "5.1.11",
    "papaparse": "5.5.3",
    "pinia": "3.0.4",
    "vue": "3.5.34",
    "vue-i18n": "^11.4.4",
    "vue-router": "5.0.7"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.16.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@types/papaparse": "^5.5.2",
    "@types/vue": "^1.0.31",
    "@types/vue-router": "^2.0.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vicons/material": "^0.13.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/ui": "^4.1.7",
    "@vue/compiler-sfc": "^3.5.34",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.10",
    "eslint": "^10.4.0",
    "eslint-plugin-vue": "^10.9.1",
    "jsdom": "^29.1.1",
    "naive-ui": "^2.44.1",
    "prettier": "^3.8.3",
    "terser": "^5.47.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.13",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vitest": "^4.1.7"
  }
}
