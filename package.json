{
  "name": "9cmd",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:scan": "node scripts/scanner.cjs",
    "test:fetch": "node scripts/fetch-test-data.cjs",
    "test:logic": "vitest run src/__tests__/logic",
    "test:integration": "vitest run src/__tests__/integration",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix --cache",
    "format": "prettier --write .",
    "prepare": "husky install"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.92.5",
    "@vicons/fluent": "^0.13.0",
    "@vicons/ionicons5": "^0.13.0",
    "@vueuse/core": "^14.1.0",
    "@vueuse/rxjs": "^14.1.0",
    "axios": "^1.13.2",
    "date-fns": "^4.1.0",
    "dexie": "^4.2.1",
    "lodash-es": "^4.17.22",
    "microdiff": "^1.5.0",
    "naive-ui": "^2.43.2",
    "papaparse": "^5.5.3",
    "pinia": "^3.0.4",
    "rxjs": "^7.8.2",
    "vue": "^3.5.26",
    "vue-i18n": "^11.2.8",
    "vue-router": "^4.6.4",
    "workbox-precaching": "^7.4.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.3",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.10.4",
    "@types/papaparse": "^5.5.2",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitest/eslint-plugin": "^1.6.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.2",
    "eslint-plugin-vue": "~10.6.2",
    "fake-indexeddb": "^6.2.5",
    "husky": "^8.0.0",
    "jiti": "^2.6.1",
    "jsdom": "^27.3.0",
    "lint-staged": "^16.2.7",
    "msw": "^2.12.7",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.7.4",
    "typescript": "~5.9.3",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^7.3.0",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vitest": "^4.0.16",
    "vue-tsc": "^3.2.1"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
